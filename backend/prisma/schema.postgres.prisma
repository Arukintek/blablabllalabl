datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  name      String
  role      String     @default("STUDENT")
  groupId   Int?
  group     Group?     @relation(fields: [groupId], references: [id])
  schedules Schedule[] @relation("TeacherSchedules")
  grades    Grade[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Group {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  students  User[]
  schedules Schedule[]
  homeworks Homework[]
}

model Subject {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  schedules Schedule[]
  grades    Grade[]
  homeworks Homework[]
}

model Schedule {
  id        Int        @id @default(autoincrement())
  dayOfWeek String
  timeSlot  String
  groupId   Int
  group     Group      @relation(fields: [groupId], references: [id])
  subjectId Int
  subject   Subject    @relation(fields: [subjectId], references: [id])
  teacherId Int
  teacher   User       @relation("TeacherSchedules", fields: [teacherId], references: [id])
  homeworks Homework[]
}

model Grade {
  id        Int      @id @default(autoincrement())
  value     Int
  comment   String?
  date      DateTime @default(now())
  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
}

model Homework {
  id         Int       @id @default(autoincrement())
  text       String
  deadline   String?
  createdAt  DateTime  @default(now())
  groupId    Int?
  group      Group?    @relation(fields: [groupId], references: [id])
  scheduleId Int?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id])
  subjectId  Int?
  subject    Subject?  @relation(fields: [subjectId], references: [id])
}